def ensure_user_path() -> None:
    extra = [str(Path.home() / ".local" / "bin"), "/usr/bin"]
    parts = [item for item in os.environ.get("PATH", "").split(":") if item]
    for path in reversed(extra):
        if path not in parts:
            parts.insert(0, path)
    os.environ["PATH"] = ":".join(parts)


ensure_user_path()
